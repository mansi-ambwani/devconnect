# Copy this file to ".env" and fill in the values.
# NEVER commit your real .env file to GitHub.

# Port the API listens on
PORT=4000

# PostgreSQL connection string
# Local (docker-compose):  postgresql://devconnect:devconnect@localhost:5432/devconnect
# Azure: postgresql://<admin-user>:<password>@<server-name>.postgres.database.azure.com:5432/devconnect
DATABASE_URL=postgresql://devconnect:devconnect@localhost:5432/devconnect

# true for Azure (Azure requires SSL), false for local
DB_SSL=false

# A long random string used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed to call this API (comma-separated)
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
